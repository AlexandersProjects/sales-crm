# ===========================
# Sales CRM - Environment Configuration
# ===========================
# Copy this file to .env and customize the values
# DO NOT commit the .env file to version control!

# ===========================
# Database Configuration
# ===========================
# PostgreSQL connection settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sales_crm
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full database URL (auto-constructed in Docker)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/sales_crm

# ===========================
# Application Settings
# ===========================
# Default tenant ID
TENANT_ID=1

# Environment mode (development, staging, production)
ENVIRONMENT=development

# Debug mode (true/false)
DEBUG=true

# ===========================
# API Keys
# ===========================
# OpenAI API Key (optional - required for AI email generation feature)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# ===========================
# Server Configuration
# ===========================
# Backend API settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# Frontend settings
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# ===========================
# CORS Settings
# ===========================
# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===========================
# Logging
# ===========================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ===========================
# Security (Production)
# ===========================
# Secret key for JWT tokens (generate with: openssl rand -hex 32)
# SECRET_KEY=your-secret-key-here

# JWT settings
# JWT_ALGORITHM=HS256
# JWT_EXPIRATION_MINUTES=30

# ===========================
# Rate Limiting (Future)
# ===========================
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_PER_MINUTE=60

# ===========================
# Email Settings (Future)
# ===========================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@salescrm.com

# ===========================
# Feature Flags
# ===========================
# Enable/disable features
FEATURE_AI_EMAIL=true
FEATURE_EMAIL_SENDING=false

# ===========================
# Development Tools
# ===========================
# Auto-reload on code changes (development only)
AUTO_RELOAD=true

# Show SQL queries in logs (development only)
SHOW_SQL_QUERIES=false

# ===========================
# Notes
# ===========================
# 1. Copy this file to .env: cp .env.example .env
# 2. Update the values above with your actual configuration
# 3. Never commit .env to version control!
# 4. For production, use strong passwords and secure secrets
# 5. Environment variables can be overridden by Docker Compose

