# Poetry
poetry.lock
# Hatch
.hatch/
# Pipenv
Pipfile.lock
# PDM
pdm.lock
__pypackages__/

# === Docker ===
.dockerignore
docker-compose.override.yml
.docker/
*.pid

# === Security ===
# Private keys
*.pem
*.key
*.p12
*.pfx

# === Archives ===
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# === Node / Frontend (if present) ===
node_modules/
dist/
build/
.cache/
.eslintcache
.parcel-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === Misc ===
# Editor backup and lock files
*.kate-swp
*.sublime-workspace
*.sublime-project
*~lock.*
# System restore files
*.bak
*.old
*.orig
*.tmp

# === Local temp debug folders ===
# Ignore temporary debug/demo directories created during development
tmp_*/
.tmp_*/
# Also ignore any env_guard tmp folders
tmp*/

# === End of file ===
