tmp_*/
tmp_*.env
tmp_*.py
.env.test*
.env.suggested

# === Coverage & Reports ===
.coverage
coverage/
*.lcov
.nyc_output/
reports/
*.htmlcov
*.xml

# === Type Checking ===
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# === Linting / Formatting ===
.pyre/
ruff_cache/
.pyright/
.black/
isort.*
pylint.*

# === Docs (keep source .md files, exclude builds) ===
docs/_build/
docs/build/
doc/_build/
build/docs/
site/
# Keep docs/*.md files - they're valuable documentation!

# === Database / Cache ===
*.db
*.sqlite
*.sqlite3
*.pdb
__pycache__/

