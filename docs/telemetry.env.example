# Example .env configuration for env_guard telemetry

# Telemetry Configuration
# ----------------------
# Set to 'true' to enable anonymous telemetry (helps improve env_guard)
# Set to 'false' or leave unset to disable telemetry
# Default: false (opt-in required)
ENV_GUARD_TELEMETRY=true

# Optional: Supabase backend configuration for telemetry
# Only needed if you're using the telemetry feature
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-key

# Other env_guard settings can go here...

